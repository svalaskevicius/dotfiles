#!/usr/bin/env bash

set -euo pipefail

# Find git root: cwd if it has .git, walk up parents, fallback to cwd
WORKSPACE_DIR="$PWD"
while [ ! -d "$WORKSPACE_DIR/.git" ]; do
  WORKSPACE_DIR="$(dirname "$WORKSPACE_DIR")"
  if [ "$WORKSPACE_DIR" = "/" ]; then
    WORKSPACE_DIR="$PWD"
    break
  fi
done

# Compute relative path from git root to original cwd for --chdir
if [[ "$PWD" == "$WORKSPACE_DIR/"* ]]; then
  CHDIR_PATH="${PWD#$WORKSPACE_DIR/}"
else
  CHDIR_PATH="."
fi

SHARE_NET=0
ADD_HOME=0
ROCM=0
while [ $# -gt 0 ] ; do
    case "$1" in
        "--with-net") 
            SHARE_NET=1 
            shift
            ;;
        "--home") 
            ADD_HOME=1 
            shift
            ;;
        "--rocm") 
            ROCM=1 
            shift
            ;;
        *) break
    esac
done

TMP="/tmp/sandbox-$(pwd | md5sum - | cut -d' ' -f1)"

# function clean_on_exit() {
#     rm -rf "$TMP"
# }
# 
# trap clean_on_exit EXIT

mkdir -p "$TMP"


bwrap_args=(
  --unshare-all
  # --share-net

  --ro-bind /usr /usr
  --ro-bind /bin /bin
  --ro-bind /lib /lib
  --ro-bind /lib64 /lib64

  --ro-bind /sbin /sbin

  --ro-bind /etc/resolv.conf /etc/resolv.conf
  --ro-bind /etc/hosts /etc/hosts
  --ro-bind /etc/passwd /etc/passwd
  --ro-bind /etc/group /etc/group
  --ro-bind /etc/ssl /etc/ssl
  --ro-bind /etc/ca-certificates /etc/ca-certificates
  --ro-bind /etc/java21-openjdk /etc/java21-openjdk

  --proc /proc
  --bind "$TMP" /tmp
  --dev /dev
)

if [ "$SHARE_NET" = "1" ] ; then
    bwrap_args+=( --share-net )
fi

if [ "$ADD_HOME" = "1" ] ; then
    HOME_DIR="$WORKSPACE_DIR/.sandbox-home"
    mkdir -p "$HOME_DIR"
    bwrap_args+=( --bind "$HOME_DIR" "$HOME" )
fi

if [ "$ROCM" = "1" ] ; then
    bwrap_args+=(
        --ro-bind /opt/rocm /opt/rocm
        --dev-bind /dev/kfd /dev/kfd
        --dev-bind /dev/dri /dev/dri
        --ro-bind /sys /sys
    )
fi

bwrap_args+=(
  --dir "$HOME"
  --setenv HOME "$HOME"
  --setenv TMPDIR /tmp

  --bind "$WORKSPACE_DIR" "$WORKSPACE_DIR"
  --chdir "$WORKSPACE_DIR/${CHDIR_PATH}"

  --setenv PATH "$WORKSPACE_DIR/${CHDIR_PATH}/node_modules/.bin:$HOME/.local/bin:$HOME/.local/share/coursier/bin:/usr/local/bin:/usr/bin:/bin"
  --unsetenv SSH_AUTH_SOCK
  --unsetenv SSH_AGENT_PID

  --bind "$XDG_RUNTIME_DIR" "$XDG_RUNTIME_DIR"

  --die-with-parent
)



# exec bwrap "${bwrap_args[@]}" -- "$@"
exec bwrap "${bwrap_args[@]}" -- bash -c 'source .envrc 2>/dev/null || true; exec "$0" "$@"' -- "$@"

