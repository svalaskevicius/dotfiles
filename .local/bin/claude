#!/usr/bin/env bash

set -euo pipefail

CURRENT="$(readlink -f "$0")"
if [[ "$1" == "--bash" ]]; then
    ORIG="bash"
    shift
else
    ORIG="$(which -a claude | grep -v "$CURRENT" | head -n1)"
fi

if test -z "${ORIG:-}"; then
  echo "No claude found (wrapper at $CURRENT)" >&2
  exit 1
fi

# Find git root: cwd if it has .git, walk up parents, fallback to cwd
WORKSPACE_DIR="$PWD"
while [ ! -d "$WORKSPACE_DIR/.git" ]; do
  WORKSPACE_DIR="$(dirname "$WORKSPACE_DIR")"
  if [ "$WORKSPACE_DIR" = "/" ]; then
    WORKSPACE_DIR="$PWD"
    break
  fi
done

# Compute relative path from git root to original cwd for --chdir
if [[ "$PWD" == "$WORKSPACE_DIR/"* ]]; then
  CHDIR_PATH="${PWD#$WORKSPACE_DIR/}"
else
  CHDIR_PATH="."
fi

HOME_DIR="$HOME"

mkdir -p "$HOME_DIR/.claude"
mkdir -p "$HOME_DIR/.claude/codebase-memory-mcp"

bwrap_args=(
  --unshare-all
  --share-net

  --ro-bind /usr /usr
  --ro-bind /bin /bin
  --ro-bind /lib /lib
  --ro-bind /lib64 /lib64

  --ro-bind /usr/sbin /usr/sbin
  --ro-bind /sbin /sbin

  --ro-bind /etc/resolv.conf /etc/resolv.conf
  --ro-bind /etc/hosts /etc/hosts
  --ro-bind /etc/passwd /etc/passwd
  --ro-bind /etc/group /etc/group

  --proc /proc
  --tmpfs /tmp
  --dev /dev

  --dir /home/dev
  --setenv HOME /home/dev
  --setenv TMPDIR /tmp
  --setenv XDG_CONFIG_HOME /home/dev/.config
  --setenv XDG_CACHE_HOME /home/dev/.cache

  --ro-bind "$HOME_DIR/.gitconfig" /home/dev/.gitconfig
  --ro-bind "$HOME_DIR/.gitignore_global" /home/dev/.gitignore_global

  --bind "$HOME_DIR/.claude" /home/dev/.claude
  --bind "$HOME_DIR/.claude.json" /home/dev/.claude.json
  --bind "$HOME_DIR/.cache/claude-cli-nodejs" /home/dev/.cache/claude-cli-nodejs

  --bind "$HOME_DIR/.cache/uv" /home/dev/.cache/uv
  --bind "$HOME_DIR/.npm" /home/dev/.npm
  --bind "$HOME_DIR/.claude/codebase-memory-mcp" /home/dev/.cache/codebase-memory-mcp

  --ro-bind /opt/claude-code /opt/claude-code
  --ro-bind /home/sarunas/src/semantic-edit-mcp/target/release/semantic-edit-mcp /opt/semantic-mcp/semantic-edit-mcp

  --bind "$WORKSPACE_DIR" /workspace
  --chdir "/workspace/${CHDIR_PATH}"

  --setenv PATH "/usr/local/bin:/usr/bin:/bin:/workspace/${CHDIR_PATH}/node_modules/.bin"
  --setenv OPENSPEC_TELEMETRY 0

  --die-with-parent
)

# exec bwrap "${bwrap_args[@]}" -- bash -c 'source .envrc 2>/dev/null || true; exec "$0" "$@"' -- bash
exec bwrap "${bwrap_args[@]}" -- bash -c 'source .envrc 2>/dev/null || true; exec "$0" "$@"' -- "$ORIG" "$@"
# exec bwrap "${bwrap_args[@]}" -- "$ORIG" "$@"
# exec bwrap "${bwrap_args[@]}" -- bash 

