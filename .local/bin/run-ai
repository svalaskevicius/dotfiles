#!/bin/bash

# llama.cpp model registry - optimized for AMD 7900 XTX (24GB VRAM)
# Usage: run-ai [model-id]

DATA=/home/sarunas/ai-models/
PRESET="$DATA/models.ini"

export ROCR_VISIBLE_DEVICES=0


# Build base command using llama.cpp's native registry support
ARGS=(
 "--models-dir" "$DATA"
 "--models-preset" "$PRESET"
  # Common overrides applied on top of registry presets
  --jinja
  --keep 4096
  --port 8471 --host 0.0.0.0
)

# Pass through any additional args after the model ID
shift 2>/dev/null || true
if [ $# -gt 0 ]; then
  ARGS+=("$@")
fi

set -x
llama-server "${ARGS[@]}"
