#!/usr/bin/env bash

set -euo pipefail

SYSTEM_OVERLAY="$HOME/.local/state/opencode/system-overlay"
CURRENT="$(readlink -f "$0")"
if [[ "${1:-}" == "--bash" ]]; then
    ORIG="/usr/bin/bash"
    shift
else
    ORIG="$(which -a opencode | grep -v "$CURRENT" | head -n1)"
fi

if test -z "${ORIG:-}"; then
  echo "No opencode found (wrapper at $CURRENT)" >&2
  exit 1
fi

# Find git root: cwd if it has .git, walk up parents, fallback to cwd
WORKSPACE_DIR="$PWD"
while [ ! -d "$WORKSPACE_DIR/.git" ]; do
  WORKSPACE_DIR="$(dirname "$WORKSPACE_DIR")"
  if [ "$WORKSPACE_DIR" = "/" ]; then
    WORKSPACE_DIR="$PWD"
    break
  fi
done

# Compute relative path from git root to original cwd for --chdir
if [[ "$PWD" == "$WORKSPACE_DIR/"* ]]; then
  CHDIR_PATH="${PWD#$WORKSPACE_DIR/}"
else
  CHDIR_PATH="."
fi


mkdir -p "$SYSTEM_OVERLAY"

bwrap_args=(
  --unshare-all
  --share-net

  --ro-bind /usr /usr
  --ro-bind /bin /bin
  --ro-bind /lib /lib
  --ro-bind /lib64 /lib64

  --ro-bind /usr/sbin /usr/sbin
  --ro-bind /sbin /sbin

  --ro-bind /etc/resolv.conf /etc/resolv.conf
  --ro-bind /etc/hosts /etc/hosts
  --ro-bind /etc/passwd /etc/passwd
  --ro-bind /etc/group /etc/group
  --ro-bind /etc/ssl /etc/ssl
  --ro-bind /etc/ca-certificates /etc/ca-certificates
  --ro-bind /etc/java21-openjdk /etc/java21-openjdk

  --proc /proc
  --tmpfs /tmp
  --dev /dev

  --bind "$SYSTEM_OVERLAY" "$HOME"
  --setenv HOME "$HOME"
  --setenv TMPDIR /tmp
  --setenv XDG_CONFIG_HOME "$HOME/.config"
  --setenv XDG_CACHE_HOME "$HOME/.cache"

  --ro-bind "$HOME/.gitconfig" "$HOME/.gitconfig"
  --ro-bind "$HOME/.gitignore_global" "$HOME/.gitignore_global"
  --ro-bind "$HOME/dev/.gitemail" "$HOME/dev/.gitemail" 

  --bind "$HOME/.config/opencode" "$HOME/.config/opencode"

  --bind "$WORKSPACE_DIR" "$WORKSPACE_DIR"
  --chdir "$WORKSPACE_DIR/${CHDIR_PATH}"

  --setenv PATH "$WORKSPACE_DIR/${CHDIR_PATH}/node_modules/.bin:$HOME/.local/bin:$HOME/.local/share/coursier/bin:/usr/local/bin:/usr/bin:/bin"
  --setenv OPENSPEC_TELEMETRY 0
  --unsetenv SSH_AUTH_SOCK
  --unsetenv SSH_AGENT_PID

  --setenv OPENCODE_EXPERIMENTAL_LSP_TOOL 1

  --die-with-parent
)

for m in "$HOME/.local/bin/git" "$HOME/.local/bin/sandbox" "$HOME/.local/share/coursier" ; do
  if test -e "$m"; then
    bwrap_args+=( --ro-bind "$m" "$m" )
  fi
done

# exec bwrap "${bwrap_args[@]}" -- bash -c 'source .envrc 2>/dev/null || true; exec "$0" "$@"' -- bash
exec bwrap "${bwrap_args[@]}" -- bash -c 'source .envrc 2>/dev/null || true; exec "$0" "$@"' -- "$ORIG" "$@"
# exec bwrap "${bwrap_args[@]}" -- "$ORIG" "$@"
# exec bwrap "${bwrap_args[@]}" -- bash 

